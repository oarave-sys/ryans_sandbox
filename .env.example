# Copy this file to ".env" and fill in real values before running
# `docker compose up -d`. Keep .env private — it holds secrets.

# Database password (choose a long random string).
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Secret used to sign login sessions (choose a long random string, 32+ chars).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-secret

# The first administrator account, created automatically on first startup.
# You will be forced to change this password at first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-temporary-password

# Minutes of inactivity before a session expires (server-side). The browser
# also signs users out after 15 minutes idle.
SESSION_MINUTES=30

# Set SECURE_COOKIES=1 and TRUST_PROXY=1 once you put an HTTPS reverse proxy
# in front of the app (strongly recommended — see DEPLOY.md).
SECURE_COOKIES=0
TRUST_PROXY=
